# WalletConnect Project ID
# Get your project ID from https://cloud.walletconnect.com/
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Backend API URL (Ponder indexer)
# IPFS uploads are now handled securely through the backend
VITE_BACKEND_API_URL=http://localhost:42069

# Arbitrum Sepolia RPC URL (optional - defaults to public RPC)
# Get your API key from https://infura.io/ or https://alchemy.com/
VITE_ARBITRUM_RPC_URL=https://arbitrum-sepolia.infura.io/v3/your_api_key_here
